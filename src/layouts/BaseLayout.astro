---
/**
 * 考试中心的外壳：can-ui `CanFrame`，经 `Frame.vue`。考生页 content 布局，`/admin` tool 布局。
 *
 * 会话在服务端读好传进去，首屏就画对「你是谁」。页脚由 CanFrame 画。
 */
import "@/styles/globals.css";
import ThemeScript from "@jianyuelab-org/can-ui/components/ThemeScript.astro";
import Frame from "@/components/Frame.vue";
import { pageTitle } from "@/lib/pageTitle";
import { signOutTarget } from "@/lib/signOutTarget";
import { getLocale, getMessages } from "@/lib/i18n";
import type { Member } from "@/lib/member";
import { signInUrl } from "@/server/config";

interface Props {
  title?: string;
  member: Member | null;
}

const { title, member } = Astro.props;

const locale = getLocale(Astro.cookies);
const messages = getMessages(locale, "frame");
const pageTitleText = pageTitle(title, locale);
const path = Astro.url.pathname;
const isAdmin = path === "/admin" || path.startsWith("/admin/");
---

<!doctype html>
<html lang={locale} class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <title>{pageTitleText}</title>
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0b0f14"
      media="(prefers-color-scheme: dark)"
    />
    {/* 考试页面不该出现在搜索结果里，也不该被抓。 */}
    <meta name="robots" content="noindex, nofollow" />
    <ThemeScript />
  </head>
  <body class="bg-surface text-ink">
    <Frame
      messages={messages}
      locale={locale}
      member={member}
      pathname={path}
      signInHref={signInUrl(Astro.url)}
      layout={isAdmin ? "tool" : "content"}
      afterSignOut={signOutTarget(path)}
      client:load
    >
      {
        isAdmin ? (
          // tool 布局：CanFrame 已经包了内边距，这里直接放内容。
          <slot />
        ) : (
          <div class="page-gutter w-full py-8">
            <slot />
          </div>
        )
      }
    </Frame>
  </body>
</html>
