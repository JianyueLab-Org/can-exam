---
/**
 * 题库管理：卷子清单。
 *
 * 上游是 `/api/v1/super/exam/papers`，挂在 `WithSuper`（教员及以上）后面，再
 * 由它自己按 division 过滤 —— 一个 JPN 的教员在这里拿到的只有 JPN 的卷子。
 *
 * **这一页不自己判断权限。** 读不到就是 `forbidden`，岛屿显示一句话。理由见
 * `src/pages/api/v1/admin/papers.ts`：两处各判一次的话，两处会慢慢长得不一
 * 样，而更宽松的那一处就是实际生效的那一处。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import BankPapers from "@/components/BankPapers.vue";
import { getLocale, getMessages } from "@/lib/i18n";
import type { AdminPaper, BankAuthority } from "@/lib/admin";
import { readMember } from "@/server/session";
import { readApi } from "@/server/upstream";

const locale = getLocale(Astro.cookies);
const messages = getMessages(locale);

const member = await readMember(Astro);
const response = member
  ? await readApi<{
      data?: { papers: AdminPaper[]; authority: BankAuthority };
    }>(Astro, "/api/v1/super/exam/papers")
  : null;
const papers = response?.data?.papers ?? [];
// 上游算好的权限：能管哪些 division、最高能授予到哪一级。前端不自己算 —— 那要
// 查 division 表，而这个站点不碰数据库。
const authority = response?.data?.authority ?? null;
---

<BaseLayout title="题库管理" member={member} active="admin">
  <BankPapers
    messages={messages}
    papers={papers}
    authority={authority}
    forbidden={!response}
    client:load
  />
</BaseLayout>
