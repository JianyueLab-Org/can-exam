---
/**
 * 题库管理：卷子清单。
 *
 * 上游 `/api/v1/super/exam/papers` 挂在 `WithSuper` 后面，再按 division 过滤。
 * 这一页不自己判断权限：上游答 403 就在原地址渲染 `NoAccess`，HTTP 403。
 */
import { NoAccess, originsFromEnv } from "@jianyuelab-org/can-ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BankPapers from "@/components/BankPapers.vue";
import { bankRefusal } from "@/lib/access";
import type { AdminPaper, BankAuthority } from "@/lib/admin";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { signInUrl } from "@/server/config";
import { readMember } from "@/server/session";
import { callApi } from "@/server/upstream";

const locale = getLocale(Astro.cookies);
const messages = getMessages(locale);
const frameMessages = getMessages(locale, "frame");
const t = useTranslations(locale, "admin");

const member = await readMember(Astro);
if (!member) {
  return Astro.redirect(signInUrl(Astro.url), 302);
}

const result = await callApi(Astro, "/api/v1/super/exam/papers");
if (result.status === 401) {
  return Astro.redirect(signInUrl(Astro.url), 302);
}

const refusal = bankRefusal(member, result.status, t("access.permission"));
if (refusal) Astro.response.status = 403;

let papers: AdminPaper[] = [];
// 上游算好的权限：能管哪些 division、最高能授予到哪一级。
let authority: BankAuthority | null = null;
let failed = true;
if (result.status >= 200 && result.status < 300) {
  try {
    const body = JSON.parse(result.body) as {
      data?: { papers: AdminPaper[]; authority: BankAuthority };
    };
    papers = body.data?.papers ?? [];
    authority = body.data?.authority ?? null;
    failed = false;
  } catch {
    // 读不懂就当失败，岛屿显示那一句。
  }
}
---

<BaseLayout title={t("title")} member={member} wide>
  {
    refusal ? (
      <NoAccess
        reason={refusal}
        userName={member.name}
        userId={member.username}
        current="exam"
        locale={locale}
        rating={member.rating}
        messages={frameMessages}
        origins={originsFromEnv(import.meta.env)}
      >
        <p slot="next-steps" class="text-sm text-muted">
          {t("access.hint")}
        </p>
      </NoAccess>
    ) : (
      <BankPapers
        messages={messages}
        papers={papers}
        authority={authority}
        forbidden={failed}
        client:load
      />
    )
  }
</BaseLayout>
