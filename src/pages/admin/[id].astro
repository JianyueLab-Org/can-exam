---
/**
 * 一份卷子的题库。全站唯一渲染正确答案的页面。
 *
 * 类型走 `lib/admin.ts`，和考生侧的 `lib/exams.ts` 不共享。上游对清单答 403 时
 * 在原地址渲染 `NoAccess`，HTTP 403。别的 division 的卷子不在过滤后的清单里，
 * 岛屿照旧显示「没有权限」。
 */
import { NoAccess, originsFromEnv } from "@jianyuelab-org/can-ui";
import BaseLayout from "@/layouts/BaseLayout.astro";
import BankQuestions from "@/components/BankQuestions.vue";
import { bankRefusal } from "@/lib/access";
import type { AdminPaper, AdminQuestion } from "@/lib/admin";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { signInUrl } from "@/server/config";
import { readMember } from "@/server/session";
import { callApi, readApi } from "@/server/upstream";

const { id } = Astro.params;
const locale = getLocale(Astro.cookies);
const messages = getMessages(locale);
const frameMessages = getMessages(locale, "frame");
const t = useTranslations(locale, "admin");

const member = await readMember(Astro);
if (!member) {
  return Astro.redirect(signInUrl(Astro.url), 302);
}

// 上游没有按 id 读卷子的管理端路由，卷子的元信息只在清单里。
const [list, bank] = await Promise.all([
  callApi(Astro, "/api/v1/super/exam/papers"),
  readApi<{ data?: { questions: AdminQuestion[] } }>(
    Astro,
    `/api/v1/super/exam/papers/${encodeURIComponent(id ?? "")}/questions`,
  ),
]);
if (list.status === 401) {
  return Astro.redirect(signInUrl(Astro.url), 302);
}

const refusal = bankRefusal(member, list.status, t("access.permission"));
if (refusal) Astro.response.status = 403;

let paper: AdminPaper | null = null;
let questions: AdminQuestion[] = [];
let forbidden = true;
if (list.status >= 200 && list.status < 300) {
  try {
    const body = JSON.parse(list.body) as { data?: { papers: AdminPaper[] } };
    forbidden = false;
    paper = body.data?.papers.find((item) => String(item.id) === id) ?? null;
    questions = bank?.data?.questions ?? [];
  } catch {
    // 读不懂就当失败。
  }
}
---

<BaseLayout title={paper?.title ?? t("title")} member={member} wide>
  {
    refusal ? (
      <NoAccess
        reason={refusal}
        userName={member.name}
        userId={member.username}
        current="exam"
        locale={locale}
        rating={member.rating}
        messages={frameMessages}
        origins={originsFromEnv(import.meta.env)}
      >
        <p slot="next-steps" class="text-sm text-muted">
          {t("access.hint")}
        </p>
      </NoAccess>
    ) : (
      <BankQuestions
        messages={messages}
        paper={paper}
        questions={questions}
        forbidden={forbidden}
        client:load
      />
    )
  }
</BaseLayout>
