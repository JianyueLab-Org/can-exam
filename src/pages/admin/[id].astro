---
/**
 * 一份卷子的题库。
 *
 * **这是全站唯一会把正确答案渲染出来的页面。** 它和考生那一侧走的是两条不同
 * 的上游路径、两个不同的 TypeScript 类型（`lib/admin.ts` 对 `lib/exams.ts`），
 * 这一点是有意维持的：类型不共享，「在考生页面上顺手读一下 isCorrect」就编译
 * 不过，而不是在运行时悄悄拿到 undefined。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import BankQuestions from "@/components/BankQuestions.vue";
import { getLocale, getMessages } from "@/lib/i18n";
import type { AdminPaper, AdminQuestion } from "@/lib/admin";
import { readMember } from "@/server/session";
import { readApi } from "@/server/upstream";

const { id } = Astro.params;
const locale = getLocale(Astro.cookies);
const messages = getMessages(locale);

const member = await readMember(Astro);

let paper: AdminPaper | null = null;
let questions: AdminQuestion[] = [];
let forbidden = true;

if (member) {
  // 卷子清单和题目一起读：上游没有「按 id 读一份卷子」的管理端路由，卷子的元
  // 信息（抽题数、标题）只有在清单里。多读几行，省一条路由。
  //
  // 顺带也是一道权限检查：清单是上游按 division 过滤过的，所以别人 division
  // 的卷子在这里根本 find 不到，`paper` 是 null，页面显示「没有权限」。题目那
  // 一次调用上游也会自己判（那边答 404），两边独立成立。
  const [papers, bank] = await Promise.all([
    readApi<{ data?: { papers: AdminPaper[] } }>(
      Astro,
      "/api/v1/super/exam/papers",
    ),
    readApi<{ data?: { questions: AdminQuestion[] } }>(
      Astro,
      `/api/v1/super/exam/papers/${encodeURIComponent(id ?? "")}/questions`,
    ),
  ]);
  if (papers) {
    forbidden = false;
    paper = papers.data?.papers.find((item) => String(item.id) === id) ?? null;
    questions = bank?.data?.questions ?? [];
  }
}
---

<BaseLayout
  title={paper?.title ?? "题库管理"}
  member={member}
  active="admin"
  wide
>
  <BankQuestions
    messages={messages}
    paper={paper}
    questions={questions}
    forbidden={forbidden}
    client:load
  />
</BaseLayout>
