---
/**
 * 考试中心首页。
 *
 * 卷子清单和成绩单都在**服务端**读好，当作 prop 传进岛屿 —— 这一页上不该出现
 * 「先画一个骨架再填内容」。两次上游调用并发发出，串行的话首字节要等两趟。
 *
 * 没登录不是错误：`readMember` 返回 null，岛屿画一句「请先登录」加一个跳回主
 * 站的链接。这个站点没有密码表单，登录入口只有主站一个。
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import ExamCentre from "@/components/ExamCentre.vue";
import { siteUrl, originsFromEnv } from "@jianyuelab-org/can-ui";
import { getLocale, getMessages, useTranslations } from "@/lib/i18n";
import { parseScope } from "@/lib/examCentre";
import type { AttemptRecord, PaperSummary } from "@/lib/exams";
import { signInUrl } from "@/server/config";
import { readMember } from "@/server/session";
import { readApi } from "@/server/upstream";

const locale = getLocale(Astro.cookies);
// 整本字典，不是某一个命名空间：这个岛屿要读 home.*、frame.* 和 sit.error.*
// 三处 —— 交卷失败的那几个码是发卷时就可能撞上的。
const messages = getMessages(locale);
const t = useTranslations(locale, "home");

// 当前是哪一栏：服务端读 `?scope=`，转发过来的链接直接落在对的那一栏。
const scope = parseScope(Astro.url.searchParams.get("scope"));
const origins = originsFromEnv(import.meta.env);

const member = await readMember(Astro);

let papers: PaperSummary[] = [];
let records: AttemptRecord[] = [];
if (member) {
  const [paperList, history] = await Promise.all([
    readApi<{ data?: { papers: PaperSummary[] } }>(
      Astro,
      "/api/v1/pilot/exam/papers",
    ),
    readApi<{ data?: { records: AttemptRecord[] } }>(
      Astro,
      "/api/v1/pilot/exam",
    ),
  ]);
  papers = paperList?.data?.papers ?? [];
  records = history?.data?.records ?? [];
}

const signInHref = signInUrl(Astro.url);
---

<BaseLayout
  title={scope === "controllers" ? t("controllers") : undefined}
  member={member}
>
  <ExamCentre
    messages={messages}
    locale={locale}
    papers={papers}
    records={records}
    scope={scope}
    controllerHref={siteUrl("controller", "/", origins)}
    docsAtcHref={siteUrl("docs", "/zh_CN/atc", origins)}
    rosterHref={siteUrl("web", "/roster", origins)}
    signedOut={!member}
    signInHref={signInHref}
    client:load
  />
</BaseLayout>
